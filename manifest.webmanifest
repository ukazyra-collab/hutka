{
  "name": "Hutka — kart telemetry",
  "short_name": "Hutka",
  "description": "Kart telemetry, corner by corner: every braking point, apex and exit of your lap, compared with the fastest drivers on the same layout",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f5f6f8",
  "theme_color": "#1b2340",
  "lang": "en",
  "icons": [
    {
      "src": "icon-192.png?v=3",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png?v=3",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "maskable-512.png?v=3",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "file",
          "accept": [
            ".alf2",
            ".csv",
            ".zip",
            ".xrz",
            ".xrk",
            "application/octet-stream",
            "application/zip",
            "text/csv",
            "text/plain"
          ]
        }
      ]
    }
  }
}
